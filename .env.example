# =====================================================================
#  ✦ PREMIUM FILE VAULT — ENVIRONMENT CONFIGURATION (.env) ✦
# =====================================================================
# 1. Get your BOT_TOKEN from @BotFather on Telegram
# 2. Get your numeric Telegram user ID from @userinfobot for ADMIN_IDS
#    (Multiple admins supported with comma: 123456789,987654321)
# 3. DB_PATH defaults to bot_data.db in the project directory
# =====================================================================

BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_IDS=123456789
BOT_NAME=Premium File Vault
DB_PATH=bot_data.db
